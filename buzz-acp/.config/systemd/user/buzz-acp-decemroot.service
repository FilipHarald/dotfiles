[Unit]
Description=DecemRoot Buzz ACP harness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=BUZZ_RELAY_URL=wss://buzz.harmont.xyz
Environment=BUZZ_ACP_AGENT_COMMAND=%h/.local/bin/opencode
Environment=BUZZ_ACP_AGENT_ARGS=acp
Environment=BUZZ_ACP_RESPOND_TO=owner-only
Environment=BUZZ_ACP_ALLOWED_RESPOND_TO=owner-only
Environment=BUZZ_ACP_LAZY_POOL=false
Environment=BUZZ_ACP_SYSTEM_PROMPT_FILE=%h/.config/opencode/decemroot-prompt.md
Environment=OPENCODE_CONFIG=%h/.config/opencode/decemroot.jsonc
EnvironmentFile=%h/.config/opencode/opencode.env
EnvironmentFile=%h/.config/buzz-acp/decemroot.env
ExecStart=%h/c/z_EXT/buzz/target/release/buzz-acp
Restart=always
RestartSec=10
TimeoutStopSec=30
TimeoutStartSec=60
KillMode=control-group

[Install]
WantedBy=default.target

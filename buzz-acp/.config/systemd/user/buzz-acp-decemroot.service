[Unit]
Description=DecemRoot Buzz ACP harness
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=BUZZ_RELAY_URL=wss://buzz.harmont.xyz
Environment=BUZZ_ACP_AGENT_COMMAND=%h/.local/bin/opencode
Environment=BUZZ_ACP_AGENT_ARGS=acp
Environment=BUZZ_ACP_RESPOND_TO=allowlist
Environment=BUZZ_ACP_ALLOWED_RESPOND_TO=allowlist
Environment=BUZZ_ACP_RESPOND_TO_ALLOWLIST=e039edd00fee06dc1e00dba1d18ba4616636ae30ab8d9d5225c11e74b26db42b,a69c977478147d243012af60c7ac788931620ab94969970e5833dea64661f946,e795f223f08995b039ddd2e2e97038c50054b714231e15013fdee788b43633bb,4112e750a7a5e833e48587fed50a6d31d20543d878a41f2b09a0bbfc08bf0202,59f25bfd34947d40f95158d3877323e56b11ae36149f9fa09aadc4d728753dd2,fbec631ed583583c2daf902556c06cee00fc26a7ca849879661187fd9bd397f5
Environment=BUZZ_ACP_LAZY_POOL=false
Environment=BUZZ_ACP_SYSTEM_PROMPT_FILE=%h/.config/opencode/decemroot-prompt.md
Environment=BUZZ_ACP_DIRECTORY_PROFILE_FILE=%h/.config/buzz-acp/decemroot-profile.json
Environment=OPENCODE_CONFIG=%h/.config/opencode/decemroot.jsonc
EnvironmentFile=%h/.config/opencode/opencode.env
EnvironmentFile=%h/.config/buzz-acp/decemroot.env
ExecStart=%h/c/z_EXT/buzz/target/release/buzz-acp
Restart=always
RestartSec=10
TimeoutStopSec=30
TimeoutStartSec=60
KillMode=control-group

[Install]
WantedBy=default.target

{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "skill", "resource": "gstack*", "effect": "deny" },
    { "action": "skill", "resource": "terminal-control*", "effect": "deny" },
    { "action": "skill", "resource": "code-walkthrough*", "effect": "deny" },
  ],
  "update": "auto",
  "mcp": {
    "servers": {
      "gbrain-decem": {
        "type": "remote",
        "url": "http://decem.taila8aaf1.ts.net:3001/mcp",
        "disabled": false,
        "headers": {
          "Authorization": "Bearer {env:GBRAIN_DECEM_MCP_TOKEN}"
        }
      }
    }
  }
}

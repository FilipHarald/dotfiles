{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "plugins": [
    "-opencode.notifications",
    "./herdr-tui-session.js"
  ],
  "attention": {
    "notifications": false,
    "sound": false
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
